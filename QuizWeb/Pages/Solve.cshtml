@page "{id:int}"
@model SolveModel
@{
    ViewData["Title"] = "Rozwiązywanie";
}

<div class="container mt-4">

    @if (Model.Score.HasValue)
    {
        <div class="alert alert-success text-center">
            <h2 class="alert-heading">Twój wynik!</h2>
            <p class="display-3">@Model.Score / @Model.TotalQuestions</p>
            <hr />
            <a asp-page="/Index" class="btn btn-primary">Wróć do listy</a>
        </div>
    }
    else
    {
        <div class="card mb-4">
            <div class="card-header bg-primary text-white">
                <h2>@Model.CurrentQuiz.quizTitle</h2>
            </div>
        </div>

        <form method="post">
            @for (int i = 0; i < Model.CurrentQuiz.questions.Count; i++)
            {
                <div class="card mb-4 shadow-sm">
                    <div class="card-header">
                        <h5>@(i + 1). @Model.CurrentQuiz.questions[i].tresc</h5>
                    </div>

                    <div class="card-body">
                        @for (int j = 0; j < Model.CurrentQuiz.questions[i].odpowiedzi.Count; j++)
                        {
                            <div class="form-check mb-2">
                                <input class="form-check-input"
                                       type="radio"
                                       name="@( $"q_{i}" )"
                                       id="@( $"q_{i}_{j}" )"
                                       value="@j"
                                       required />

                                <label class="form-check-label"
                                       for="@( $"q_{i}_{j}" )"
                                       style="cursor: pointer; width: 100%;">
                                    @Model.CurrentQuiz.questions[i].odpowiedzi[j].tresc
                                </label>
                            </div>
                        }
                    </div>
                </div>
            }

            <div class="d-grid gap-2">
                <button type="submit" class="btn btn-success btn-lg">
                    Zakończ i sprawdź wynik
                </button>
                <a asp-page="/Index" class="btn btn-secondary">Anuluj</a>
            </div>
        </form>
    }
</div>
