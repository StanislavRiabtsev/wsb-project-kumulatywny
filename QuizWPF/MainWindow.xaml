<Window x:Class="WPFQuiz.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quiz" Height="400" Width="600">
    <Grid>

        <!-- Экран выбора файла -->
        <StackPanel x:Name="StartPanel" 
                    HorizontalAlignment="Center" 
                    VerticalAlignment="Center" 
                    TextBlock.TextAlignment="Center">
            <TextBlock Text="Wybierz plik quizu" 
                       FontSize="20" Margin="0 0 0 20" 
                       TextAlignment="Center"/>
            <Button Content="Wczytaj Quiz" Width="200" Height="40"
                    HorizontalAlignment="Center"
                    Click="LoadQuiz_Click"/>
        </StackPanel>

        <!-- Экран викторины -->
        <StackPanel x:Name="QuizPanel" Visibility="Collapsed"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock x:Name="QuestionText"
                       FontSize="18" Margin="0 0 0 20" 
                       TextAlignment="Center"/>

            <StackPanel x:Name="AnswersPanel" Margin="0 0 0 20"
                        HorizontalAlignment="Center"/>

            <Button Content="Dalej" Width="200" Height="40"
                    HorizontalAlignment="Center"
                    Click="NextQuestion_Click"/>
        </StackPanel>

        <!-- Экран результатов -->
        <StackPanel x:Name="ResultPanel" Visibility="Collapsed"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock x:Name="ResultText" FontSize="24" 
                       TextAlignment="Center"/>
        </StackPanel>

    </Grid>
</Window>
