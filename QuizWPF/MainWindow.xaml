<Window x:Class="WPFQuiz.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quiz" Height="400" Width="600"
        Background="#FF2D2D30">

    <Grid>

        <StackPanel x:Name="StartPanel" 
                    HorizontalAlignment="Center" 
                    VerticalAlignment="Center" 
                    TextBlock.TextAlignment="Center">

            <TextBlock Text="Wybierz plik quizu" 
                       FontSize="20" 
                       Margin="0 0 0 20" 
                       TextAlignment="Center"
                       Foreground="White"/>

            <Button Content="Wczytaj Quiz" 
                    Width="200" Height="40"
                    HorizontalAlignment="Center"
                    Background="#FF007ACC"
                    Foreground="White"
                    BorderBrush="Black"
                    Click="LoadQuiz_Click"/>
        </StackPanel>

        <StackPanel x:Name="QuizPanel" Visibility="Collapsed"
                    HorizontalAlignment="Center" VerticalAlignment="Center">

            <TextBlock x:Name="QuestionText"
                       FontSize="18" 
                       Margin="0 0 0 20" 
                       TextAlignment="Center"
                       Foreground="White"/>

            <StackPanel x:Name="AnswersPanel" 
                        Margin="0 0 0 20"
                        HorizontalAlignment="Center"
                        Foreground="White"/>

            <Button Content="Dalej" 
                    Width="200" Height="40"
                    HorizontalAlignment="Center"
                    Background="#FF007ACC"
                    Foreground="White"
                    BorderBrush="Black"
                    Click="NextQuestion_Click"/>
        </StackPanel>


        <StackPanel x:Name="ResultPanel" Visibility="Collapsed"
                    HorizontalAlignment="Center" VerticalAlignment="Center">

            <TextBlock x:Name="ResultText" 
                       FontSize="24" 
                       TextAlignment="Center"
                       Foreground="White"/>
        </StackPanel>

    </Grid>
</Window>
